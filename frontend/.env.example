# Kuber Player — Frontend Environment Variables
# Copy this file to .env and edit as needed.
# These are embedded at build time by Vite.

# Backend API base URL.
# Leave empty (default) to auto-detect using the same host on port 8080.
# Override this when:
#   - Frontend and backend run on different servers
#   - You are behind a reverse proxy (nginx/caddy)
#   - Backend port is different from 8080
#
# Examples:
#   VITE_BACKEND_URL=http://localhost:8080
#   VITE_BACKEND_URL=http://192.168.1.10:8080
#   VITE_BACKEND_URL=https://api.yourdomain.com
#
VITE_BACKEND_URL=
